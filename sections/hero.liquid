<section class="hero">
  <div>
    {% if section.settings.eyebrow != blank %}
      <div class="eyebrow mono">{{ section.settings.eyebrow }}</div>
    {% endif %}
    <h1 class="display">{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <div class="hero-ctas">
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="btn-primary">{{ section.settings.button_label }} &rarr;</a>
      {% endif %}
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_link }}" class="btn-ghost">{{ section.settings.link_label }}</a>
      {% endif %}
    </div>
  </div>

  <div class="hero-visual">
    {% for block in section.blocks %}
      {% if block.type == 'float_card' %}
        <div class="float-card fc{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="icon">{{ block.settings.emoji }}</span>
          <div class="tag">{{ block.settings.tag }}</div>
          <div class="name">{{ block.settings.name }}</div>
          <div class="price mono">{{ block.settings.price }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow tag", "default": "RESTOCKED THIS WEEK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop doing it the hard way." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Small tools that fix annoying everyday problems — in your makeup bag, your kitchen drawer, and around the house." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop the Drawer" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "link_label", "label": "Secondary link label", "default": "See today's top hack" },
    { "type": "url", "id": "link_link", "label": "Secondary link" }
  ],
  "blocks": [
    {
      "type": "float_card",
      "name": "Floating hack card",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Icon (emoji)", "default": "💄" },
        { "type": "text", "id": "tag", "label": "Category tag", "default": "Makeup" },
        { "type": "text", "id": "name", "label": "Product name", "default": "Silicone Sponge Holder" },
        { "type": "text", "id": "price", "label": "Price text", "default": "120 EGP" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "float_card" },
        { "type": "float_card" },
        { "type": "float_card" },
        { "type": "float_card" }
      ]
    }
  ]
}
{% endschema %}
