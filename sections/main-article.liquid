<section style="padding:60px 5%; max-width:760px;">
  <h1 class="display" style="font-size:32px; margin-bottom:8px;">{{ article.title }}</h1>
  <div class="mono" style="font-size:12px; color:var(--ink-soft); margin-bottom:26px;">{{ article.published_at | date: '%B %d, %Y' }}</div>
  {% if article.image %}
    {{ article.image | image_url: width: 900 | image_tag: style: 'width:100%; border-radius:10px; margin-bottom:26px;' }}
  {% endif %}
  <div style="font-size:15px; line-height:1.75; color:var(--ink-soft);">
    {{ article.content }}
  </div>
</section>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
